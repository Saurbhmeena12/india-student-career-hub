# ---------------------------------------------------------------------------
# Copy to .env  (never commit .env)
# ---------------------------------------------------------------------------

# Server
PORT=3000
JWT_SECRET=replace-with-a-long-random-string

# Admin account (created once, when the admins table is empty)
# In production this is REQUIRED, must not be "admin123", and must be >= 12 chars.
# The server refuses to boot otherwise, because admin123 is public in this repo.
ADMIN_PASSWORD=change-me-before-going-live

# ---- DATABASE (both options are free) -------------------------------------
# Option A (default): local SQLite file — free, zero config.
# Leave TURSO_* empty to use it.
SQLITE_FILE=./database.sqlite

# Option B: Turso free cloud SQLite — needed on Render/Vercel where disk is
# wiped. Free: 5 GB storage, ~500M row reads/month, no credit card.
# Create:  turso db create india-career-hub
# URL:     turso db show india-career-hub --url
# Token:   turso db tokens create india-career-hub
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- AI (free tier, optional) ---------------------------------------------
# Get a free key: https://aistudio.google.com/apikey  (no credit card)
# Free tier covers Flash / Flash-Lite models with daily + per-minute caps.
# Leave empty and the assistant still works in database-only retrieval mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=400
AI_RPM_LIMIT=8
